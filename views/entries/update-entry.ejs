<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

     <%- include('../partials/navbar') %>

    <h1>Update Entry</h1>

    <form action="/entries/<%= entry._id %>?_method=PUT" method="post">

        <label for="titleInput">Title:</label>
        <input value="<%= entry.title %>" id="titleInput" name="title" type="text">

        <br>

        <label for="entryBodyInput">Entry Body:</label>
        <input value="<%= entry.entryBody %>" id="entryBodyInput" name="entryBody" type="text" style="width: 350px; height: 45px;">

        <br>

        <label for="isPublicInput">Is Public:</label>
        <input value="<%= entry.isPublic %>" id="isPublicInput" name="isPublic" type="checkbox">
        
        <button>Update Entry</button>

    </form>

    
</body>
</html>